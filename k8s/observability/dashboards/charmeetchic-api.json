{
  "uid": "charmeetchic-api",
  "title": "Charme et Chic - API y pipeline",
  "description": "Disponibilidad, recursos, tráfico, errores, latencia y logs de la API; métricas del último despliegue publicadas por el pipeline (Pushgateway). Versionado en k8s/observability/dashboards.",
  "tags": ["charmeetchic", "api", "pipeline"],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "schemaVersion": 39,
  "version": 1,
  "time": { "from": "now-3h", "to": "now" },
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [
    {
      "type": "row", "title": "Disponibilidad", "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }, "id": 1, "panels": []
    },
    {
      "type": "stat", "title": "Réplicas UP (Prometheus)", "id": 2,
      "description": "Réplicas cuyo /api/actuator/prometheus responde (up == 1). 0 = API caída.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 1 },
      "targets": [ { "refId": "A", "expr": "sum(up{job=\"charmeetchic-api\", namespace=\"charmeetchic\"}) or vector(0)" } ],
      "fieldConfig": { "defaults": { "unit": "none", "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "orange", "value": 1 }, { "color": "green", "value": 2 } ] } }, "overrides": [] },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } }
    },
    {
      "type": "stat", "title": "Réplicas disponibles / deseadas", "id": 3,
      "description": "kube-state-metrics: réplicas disponibles del Deployment frente a las deseadas (HPA).",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 1 },
      "targets": [
        { "refId": "A", "legendFormat": "disponibles", "expr": "sum(kube_deployment_status_replicas_available{namespace=\"charmeetchic\", deployment=\"charmeetchic-api\"})" },
        { "refId": "B", "legendFormat": "deseadas", "expr": "sum(kube_deployment_spec_replicas{namespace=\"charmeetchic\", deployment=\"charmeetchic-api\"})" }
      ],
      "fieldConfig": { "defaults": { "unit": "none", "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] } }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "none", "textMode": "value_and_name", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } }
    },
    {
      "type": "stat", "title": "Disponibilidad (24 h)", "id": 4,
      "description": "Porcentaje del tiempo en que al menos una réplica estuvo UP en las últimas 24 h.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 1 },
      "targets": [ { "refId": "A", "expr": "avg_over_time((max(up{job=\"charmeetchic-api\", namespace=\"charmeetchic\"}) or vector(0))[24h:1m])" } ],
      "fieldConfig": { "defaults": { "unit": "percentunit", "decimals": 2, "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "orange", "value": 0.99 }, { "color": "green", "value": 0.999 } ] } }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } }
    },
    {
      "type": "stat", "title": "Reinicios de contenedores (1 h)", "id": 5,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 1 },
      "targets": [ { "refId": "A", "expr": "sum(increase(kube_pod_container_status_restarts_total{namespace=\"charmeetchic\"}[1h])) or vector(0)" } ],
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 0, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 1 }, { "color": "red", "value": 3 } ] } }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } }
    },
    {
      "type": "row", "title": "Recursos por pod", "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 6 }, "id": 10, "panels": []
    },
    {
      "type": "timeseries", "title": "CPU por pod (núcleos)", "id": 11,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 7 },
      "targets": [
        { "refId": "A", "legendFormat": "{{pod}}", "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"charmeetchic\", container!=\"\", container!=\"POD\"}[5m]))" },
        { "refId": "B", "legendFormat": "límite {{pod}}", "expr": "sum by (pod) (kube_pod_container_resource_limits{namespace=\"charmeetchic\", resource=\"cpu\"})" }
      ],
      "fieldConfig": { "defaults": { "unit": "cores", "custom": { "lineWidth": 1, "fillOpacity": 10 } }, "overrides": [ { "matcher": { "id": "byRegexp", "options": "límite.*" }, "properties": [ { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [10, 10] } }, { "id": "custom.fillOpacity", "value": 0 } ] } ] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi" } }
    },
    {
      "type": "timeseries", "title": "Memoria por pod (working set)", "id": 12,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 7 },
      "targets": [
        { "refId": "A", "legendFormat": "{{pod}}", "expr": "sum by (pod) (container_memory_working_set_bytes{namespace=\"charmeetchic\", container!=\"\", container!=\"POD\"})" },
        { "refId": "B", "legendFormat": "límite {{pod}}", "expr": "sum by (pod) (kube_pod_container_resource_limits{namespace=\"charmeetchic\", resource=\"memory\"})" }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "lineWidth": 1, "fillOpacity": 10 } }, "overrides": [ { "matcher": { "id": "byRegexp", "options": "límite.*" }, "properties": [ { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [10, 10] } }, { "id": "custom.fillOpacity", "value": 0 } ] } ] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi" } }
    },
    {
      "type": "row", "title": "Tráfico, errores y latencia", "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 15 }, "id": 20, "panels": []
    },
    {
      "type": "timeseries", "title": "Tasa de requests por endpoint (req/s)", "id": 21,
      "description": "Sin /actuator/** (scrape de Prometheus).",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 16 },
      "targets": [ { "refId": "A", "legendFormat": "{{method}} {{uri}}", "expr": "sum by (method, uri) (rate(http_server_requests_seconds_count{application=\"charmeetchic-api\", uri!~\"/actuator.*\"}[5m]))" } ],
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "lineWidth": 1, "fillOpacity": 10, "stacking": { "mode": "normal" } } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "type": "timeseries", "title": "Errores 5xx y 4xx (req/s)", "id": 22,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 16 },
      "targets": [
        { "refId": "A", "legendFormat": "5xx", "expr": "sum(rate(http_server_requests_seconds_count{application=\"charmeetchic-api\", status=~\"5..\", uri!~\"/actuator.*\"}[5m])) or vector(0)" },
        { "refId": "B", "legendFormat": "4xx", "expr": "sum(rate(http_server_requests_seconds_count{application=\"charmeetchic-api\", status=~\"4..\", uri!~\"/actuator.*\"}[5m])) or vector(0)" },
        { "refId": "C", "legendFormat": "% 5xx", "expr": "(sum(rate(http_server_requests_seconds_count{application=\"charmeetchic-api\", status=~\"5..\", uri!~\"/actuator.*\"}[5m])) or vector(0)) / sum(rate(http_server_requests_seconds_count{application=\"charmeetchic-api\", uri!~\"/actuator.*\"}[5m]))" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "lineWidth": 1, "fillOpacity": 10 } }, "overrides": [
        { "matcher": { "id": "byName", "options": "5xx" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } } ] },
        { "matcher": { "id": "byName", "options": "4xx" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } } ] },
        { "matcher": { "id": "byName", "options": "% 5xx" }, "properties": [ { "id": "unit", "value": "percentunit" }, { "id": "custom.axisPlacement", "value": "right" }, { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [10, 10] } } ] }
      ] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "type": "timeseries", "title": "Latencia p50 / p95 (todas las réplicas)", "id": 23,
      "description": "histogram_quantile sobre los buckets de http.server.requests. Umbral de la alerta p95: 300 ms.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 16 },
      "targets": [
        { "refId": "A", "legendFormat": "p50", "expr": "histogram_quantile(0.50, sum by (le) (rate(http_server_requests_seconds_bucket{application=\"charmeetchic-api\", uri!~\"/actuator.*\"}[5m])))" },
        { "refId": "B", "legendFormat": "p95", "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{application=\"charmeetchic-api\", uri!~\"/actuator.*\"}[5m])))" }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "lineWidth": 2, "fillOpacity": 0, "thresholdsStyle": { "mode": "line+area" } }, "thresholds": { "mode": "absolute", "steps": [ { "color": "transparent", "value": null }, { "color": "red", "value": 0.3 } ] } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "type": "row", "title": "Logs", "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 24 }, "id": 30, "panels": []
    },
    {
      "type": "logs", "title": "Logs de error recientes (Loki)", "id": 31,
      "description": "Logs JSON (ECS) de la API con nivel ERROR. Cada línea trae traceId para correlacionar una petición.",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 25 },
      "targets": [ { "refId": "A", "expr": "{namespace=\"charmeetchic\", container=\"api\"} | json | log_level=\"ERROR\"", "queryType": "range" } ],
      "options": { "showTime": true, "wrapLogMessage": true, "sortOrder": "Descending", "enableLogDetails": true, "dedupStrategy": "none", "prettifyLogMessage": false }
    },
    {
      "type": "row", "title": "Pipeline (CI/CD, vía Pushgateway)", "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 34 }, "id": 40, "panels": []
    },
    {
      "type": "stat", "title": "Duración del último despliegue", "id": 41,
      "description": "Segundos desde que deploy-aks aplica los manifiestos de la API hasta que pasa el smoke test (apply -> rollout -> smoke test), por entorno.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 5, "x": 0, "y": 35 },
      "targets": [ { "refId": "A", "legendFormat": "{{environment}}", "expr": "max by (environment) (charmeetchic_deploy_duration_seconds{job=\"charmeetchic-pipeline\"})" } ],
      "fieldConfig": { "defaults": { "unit": "s", "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 300 }, { "color": "red", "value": 600 } ] } }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "none", "textMode": "value_and_name", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } }
    },
    {
      "type": "stat", "title": "Cobertura de líneas / ramas", "id": 42,
      "description": "JaCoCo (unitarias + integración) del commit desplegado. Umbrales del pom.xml: 93 % líneas y 82 % ramas.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 5, "x": 5, "y": 35 },
      "targets": [
        { "refId": "A", "legendFormat": "líneas", "expr": "max(charmeetchic_coverage_lines_percent{job=\"charmeetchic-pipeline\"})" },
        { "refId": "B", "legendFormat": "ramas", "expr": "max(charmeetchic_coverage_branches_percent{job=\"charmeetchic-pipeline\"})" }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "decimals": 1, "min": 0, "max": 100, "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "orange", "value": 82 }, { "color": "green", "value": 90 } ] } }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "none", "textMode": "value_and_name", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } }
    },
    {
      "type": "stat", "title": "Tests ejecutados", "id": 43,
      "description": "Total de tests (surefire + failsafe) del commit desplegado.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 4, "x": 10, "y": 35 },
      "targets": [ { "refId": "A", "expr": "max(charmeetchic_tests_total{job=\"charmeetchic-pipeline\"})" } ],
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 0, "thresholds": { "mode": "absolute", "steps": [ { "color": "blue", "value": null } ] } }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } }
    },
    {
      "type": "stat", "title": "Último despliegue", "id": 44,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 4, "x": 14, "y": 35 },
      "targets": [ { "refId": "A", "legendFormat": "{{environment}}", "expr": "max by (environment) (charmeetchic_deploy_timestamp_seconds{job=\"charmeetchic-pipeline\"}) * 1000" } ],
      "fieldConfig": { "defaults": { "unit": "dateTimeFromNow", "thresholds": { "mode": "absolute", "steps": [ { "color": "text", "value": null } ] } }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "none", "textMode": "value_and_name", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } }
    },
    {
      "type": "table", "title": "Commit desplegado", "id": 45,
      "description": "charmeetchic_deploy_info{commit, image, run_id}: qué versión exacta corre en cada entorno.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 35 },
      "targets": [ { "refId": "A", "expr": "max by (environment, commit, image, run_id) (charmeetchic_deploy_info{job=\"charmeetchic-pipeline\"})", "format": "table", "instant": true } ],
      "transformations": [ { "id": "organize", "options": { "excludeByName": { "Time": true, "Value": true }, "renameByName": { "environment": "Entorno", "commit": "Commit", "image": "Imagen", "run_id": "Run" } } } ],
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": { "showHeader": true }
    }
  ]
}
