<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.charmeetchic</groupId>
    <artifactId>charmeetchic-api</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>charmeetchic-api</name>
    <description>API REST de inventario para la tienda de accesorios y joyas Charme et Chic</description>

    <properties>
        <java.version>17</java.version>
        <jjwt.version>0.13.0</jjwt.version>
        <!-- Tomcat fijado por seguridad: Boot 3.5.16 trae 10.1.55, que no corrige CVE-2026-55276 (10.1.56) ni
             CVE-2026-65182, CVE-2026-65905 y CVE-2026-68525 (10.1.58). Misma línea 10.1.x que soporta Boot 3.5,
             solo parches. Quitar esta propiedad cuando el Boot que se use ya traiga una versión igual o mayor. -->
        <tomcat.version>10.1.62</tomcat.version>
        <!-- Jackson fijado por seguridad: Boot 3.5.16 trae 2.21.4; 2.21.7 corrige CVE-2026-89407 y CVE-2026-89425
             (jackson-core) y CVE-2026-68497, CVE-2026-91776 y CVE-2026-91777 (jackson-databind). Solo parches de la
             misma línea 2.21.x. Quitar cuando el Boot que se use ya traiga una versión igual o mayor. -->
        <jackson-bom.version>2.21.7</jackson-bom.version>
        <!-- true = omite solo las pruebas unitarias (surefire); failsafe sigue corriendo. -->
        <skipUTs>false</skipUTs>
        <!-- Umbrales de cobertura (política de calidad, ver CONTRIBUTING.md). Se fijan unos puntos bajo la
             cobertura medida: alcanzables, pero un retroceso real hace fallar `mvn verify`. -->
        <cobertura.lineas.min>0.93</cobertura.lineas.min>
        <cobertura.ramas.min>0.82</cobertura.ramas.min>
        <cobertura.service.lineas.min>0.95</cobertura.service.lineas.min>
        <cobertura.service.ramas.min>0.85</cobertura.service.ramas.min>

        <!-- SonarCloud (job "sonarcloud" del CI). Solo identificadores públicos: el token se pasa como
             variable de entorno SONAR_TOKEN desde los secrets de GitHub y nunca se escribe aquí. -->
        <sonar.organization>dgomezpalacios</sonar.organization>
        <sonar.projectKey>DGomezPalacios_charmeetchic_api</sonar.projectKey>
        <sonar.host.url>https://sonarcloud.io</sonar.host.url>
        <!-- Reporte XML de JaCoCo (unitarias + integración) que genera `mvn verify`. -->
        <sonar.coverage.jacoco.xmlReportPaths>${project.build.directory}/site/jacoco/jacoco.xml</sonar.coverage.jacoco.xmlReportPaths>
        <!-- Mismas exclusiones de cobertura que JaCoCo (main, DTOs y entidades), para que el % de
             SonarCloud coincida con el del pipeline. El código se sigue analizando (bugs, code smells). -->
        <sonar.coverage.exclusions>
            **/CharmeetchicApiApplication.java,
            **/dto/**,
            **/entity/**
        </sonar.coverage.exclusions>
        <!-- Versión fija del scanner; al estar en el pom, Dependabot (maven) la mantiene al día. -->
        <sonar-maven-plugin.version>5.9.0.7382</sonar-maven-plugin.version>
    </properties>

    <dependencies>
        <!-- API REST + Jackson (JSON) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Persistencia JPA / Hibernate -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Spring Security (filtro JWT, roles, CORS) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- Bean Validation (@NotNull, @NotBlank, @Min, @Max...) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Base de datos en memoria para desarrollo -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Driver de PostgreSQL para el perfil "k8s" (application-k8s.yml): con varias réplicas en
             Kubernetes todas deben compartir una base real; H2 en memoria daría una base por pod.
             La versión la gestiona spring-boot-starter-parent. -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- JWT: validación de ID tokens de Firebase (RS256, claves públicas de Google vía JWKS).
             No se usa firebase-admin: verificar tokens no requiere credenciales y ese SDK arrastra
             decenas de dependencias de Google Cloud. Ver README ("Roles con custom claims"). -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- Reduce boilerplate (getters, builders, logger) -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Tests -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <!-- Scanner de SonarCloud: no se ejecuta en el build normal; el CI lo invoca con
                     `mvn ... org.sonarsource.scanner.maven:sonar-maven-plugin:sonar` y toma esta versión. -->
                <plugin>
                    <groupId>org.sonarsource.scanner.maven</groupId>
                    <artifactId>sonar-maven-plugin</artifactId>
                    <version>${sonar-maven-plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <!-- Procesador de Lombok explícito: javac (JDK 23+) ya no descubre procesadores implícitamente -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>

            <!-- Pruebas unitarias (fase test): todo excepto *IntegrationTest.
                 `mvn test` corre solo estas, así el feedback es rápido.
                 -DskipUTs=true las omite (el CI las corre en un step propio y luego ejecuta
                 `mvn verify -DskipUTs=true` para no repetirlas). -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <skipTests>${skipUTs}</skipTests>
                    <excludes>
                        <exclude>**/*IntegrationTest.java</exclude>
                    </excludes>
                </configuration>
            </plugin>

            <!-- Pruebas de integración (fases integration-test y verify): solo *IntegrationTest.
                 Levantan el contexto completo de Spring con H2 y prueban la API por HTTP.
                 El goal verify hace fallar el build si alguna falla (después de generar reportes). -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <includes>
                        <include>**/*IntegrationTest.java</include>
                    </includes>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Cobertura con JaCoCo, combinada de unitarias + integración:
                 prepare-agent define ${argLine}, que usan tanto surefire como failsafe, y ambos
                 escriben (append) en el mismo target/jacoco.exec. El reporte se genera en verify,
                 después de las pruebas de integración, con salida HTML (lectura humana),
                 XML (SonarCloud) y CSV (resumen del CI). -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.16</version>
                <configuration>
                    <excludes>
                        <!-- Clase main: solo invoca SpringApplication.run, no tiene lógica propia. -->
                        <exclude>com/charmeetchic/api/CharmeetchicApiApplication.class</exclude>
                        <!-- DTOs: son records (constructor, accessors, equals/hashCode generados por el
                             compilador); medirlos solo infla o desinfla el porcentaje sin aportar. -->
                        <exclude>com/charmeetchic/api/dto/**</exclude>
                        <!-- Entidades JPA: getters/setters/builders generados por Lombok y mapeo
                             declarativo con anotaciones; su comportamiento real lo prueban los
                             servicios y las pruebas de integración contra H2. -->
                        <exclude>com/charmeetchic/api/entity/**</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <!-- Política de calidad: si la cobertura baja de los umbrales, `mvn verify` falla
                         (y con él el check build-and-test, que bloquea el merge). -->
                    <execution>
                        <id>check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <!-- Todo el proyecto (sin las exclusiones de arriba) -->
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${cobertura.lineas.min}</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${cobertura.ramas.min}</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                                <!-- Reglas de negocio (stock, totales, estados, validación de tokens): más exigente -->
                                <rule>
                                    <element>PACKAGE</element>
                                    <includes>
                                        <include>com.charmeetchic.api.service</include>
                                    </includes>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${cobertura.service.lineas.min}</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${cobertura.service.ramas.min}</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
