# -----------------------------------------------------------------------------
# Caddy: termina HTTPS y reenvía todo al gateway.
#
# {$DOMAIN} viene del .env:
#   - En Azure: <nombre>.<region>.cloudapp.azure.com -> Caddy pide SOLO un certificado a Let's Encrypt
#     (necesita los puertos 80 y 443 abiertos en el NSG) y lo renueva automáticamente.
#   - En el PC: localhost -> Caddy usa su propia CA local (certificado no confiable: curl -k).
#
# Los certificados se guardan en el volumen caddy-data: no se vuelven a pedir en cada reinicio (Let's
# Encrypt limita cuántos certificados se piden por semana).
# -----------------------------------------------------------------------------
{$DOMAIN} {
	encode zstd gzip

	# Caddy agrega X-Forwarded-For/Proto/Host: el gateway y el backend saben que el cliente usó HTTPS.
	reverse_proxy gateway:8000

	# No anunciar la versión del servidor.
	header -Server

	log {
		output stdout
		format console
	}
}
