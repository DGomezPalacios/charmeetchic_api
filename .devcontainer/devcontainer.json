{
  "name": "charmeetchic - demo EP4 (Codespaces)",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/java:1": {
      "version": "17",
      "jdkDistro": "tem",
      "installMaven": "true"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "hostRequirements": {
    "cpus": 4,
    "memory": "16gb"
  },
  "forwardPorts": [8000, 15672],
  "portsAttributes": {
    "8000": {
      "label": "gateway (API publica)",
      "onAutoForward": "notify"
    },
    "15672": {
      "label": "consola RabbitMQ (privada)",
      "onAutoForward": "silent"
    }
  },
  "postCreateCommand": "chmod +x deploy/*.sh",
  "customizations": {
    "codespaces": {
      "openFiles": ["deploy/CODESPACES.md"]
    }
  }
}
