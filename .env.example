# =============================================================================
# Plantilla de variables para docker-compose.prod.yml.
#
#   cp .env.example .env     y reemplazar TODOS los valores CAMBIAR_...
#   (o generar uno con claves aleatorias: ./deploy/generar-env.sh <dominio> <origen-del-front>)
#
# El archivo .env tiene contraseñas: está en .gitignore y NUNCA se sube a GitHub.
# =============================================================================

# --- Dominio público de la VM ------------------------------------------------
# Azure: Portal -> IP pública de la VM -> Configuración -> "Etiqueta de nombre DNS".
# Caddy pide el certificado HTTPS de Let's Encrypt para este nombre.
DOMAIN=CAMBIAR_nombre.eastus.cloudapp.azure.com

# --- Frontend ----------------------------------------------------------------
# Origen EXACTO del panel Angular en Firebase Hosting (sin "/" al final). http://localhost:4200 ya va incluido.
FRONTEND_ORIGIN=https://charme-et-chic.web.app

# --- Firebase ----------------------------------------------------------------
FIREBASE_PROJECT_ID=charme-et-chic

# --- RabbitMQ (clúster de 2 nodos) -------------------------------------------
# Usuario administrador del broker (NO usar guest). Lo usan la API, rabbit-admin y la consola web.
RABBITMQ_USERNAME=charme_admin
RABBITMQ_PASSWORD=CAMBIAR_clave_larga_rabbitmq
# Secreto compartido por los nodos del clúster (igual en los dos). Generar con: openssl rand -hex 32
RABBITMQ_ERLANG_COOKIE=CAMBIAR_cookie_de_64_caracteres_hex
# Puerto de la consola web en la VM (abrirlo en el NSG SOLO para tu IP)
RABBITMQ_CONSOLE_PORT=15672

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_DB=charmeetchic
POSTGRES_USER=charmeetchic
POSTGRES_PASSWORD=CAMBIAR_clave_larga_postgres

# --- Demo --------------------------------------------------------------------
# simularError en POST /api/reports/inventory/async (reintentos y DLQ en vivo). Activo para la demo.
MESSAGING_SIMULATED_FAILURES=true
